#!/bin/bash

startup_canTakeover=true;
backup_currentlyServing=false;

servicesProblem=false;
batteryProblem=false;

checkGunicorn(){

if sudo rc-service gunicorn status && curl -fsS --max-time 5 http://127.0.0.1:8000/ > /dev/null; then
	echo "Gunicorn healthy"	
	return 0
else
	echo "Gunicorn unhealthy"
	startup_canTakeover=false;
	return 1
fi

}

checkApache(){

if sudo rc-service apache2 status; then
	echo "Apache healthy"
	return 0;
else 
	echo "Apache unhealthy"
	startup_canTakeover=false;
	return 1;
fi

}

checkBattery(){

capacity="$(</sys/class/power_supply/qcom_qg/capacity)"
status="$(</sys/class/power_supply/pm8150b-charger/status)"

if [[ "$capacity" -lt 20 && "$status" == "Discharging" ]]; then

	return 1;
else

	return 0;
fi

}

healthcheck() {


if checkGunicorn && checkApache; then
	echo "Services are up and healthy" | tee -a /home/user/recovery_backup/takeoverLog;


else
	echo "Services are not healthy" | tee -a /home/user/recovery_backup/takeoverLog;
	echo "passive" > /tmp/mystate;
	servicesProblem=true;
	return 1;
fi

if checkBattery; then
	echo "Battery in good health" | tee -a /home/user/recovery_backup/takeoverLog;
else
	batteryProblem=true;
	echo "Battery not in good health" | tee -a /home/user/recovery_backup/takeoverLog;
	echo "passive" > /tmp/mystate;
	return 1;
fi

return 0;

}

getHealthy(){
if $batteryProblem; then
	echo "Battery Problem. Nothing I can do to help" | tee -a /home/user/recovery_backup/takeoverLog;
fi

if $servicesProblem; then
	echo "I will restart services so maybe it will work in the next run" | tee -a /home/user/recovery_backup/takeoverLog;
	/home/user/recovery_backup/recoveryScript
fi
}

letEverybodyKnow(){

	echo active > /tmp/mystate
	
	if sudo arping -A -I wlan0 -c 5 192.168.1.5; then
	echo "Succesfully let other devices know of the IP address change."
	else
	echo "Failed to let other devices know of the IP address change."
	fi

}

if ping -c 1 192.168.1.5 > /dev/null; then

	backup_currentlyServing=true;
	
else
	sleep 2
	if ping -c 1 192.168.1.5 > /dev/null; then
		
		backup_currentlyServing=true;

	fi
fi

if  ! $backup_currentlyServing; then
	echo "Router's port forwarding IP address is free. Let's perform health checks and take over." | tee -a /home/user/recovery_backup/takeoverLog;
	if healthcheck; then
		echo "Server passed health checks." | tee -a /home/user/recovery_backup/takeoverLog;
		echo "Adding the router's port forwarding IP address now" | tee -a /home/user/recovery_backup/takeoverLog;
		if sudo ip addr add 192.168.1.5/24 dev wlan0; then
			echo "Successfully Added the address" | tee -a /home/user/recovery_backup/takeoverLog;
			letEverybodyKnow
		else
			echo "Address couldn't be added successfully" | tee -a /home/user/recovery_backup/takeoverLog;
		fi
	else

		echo "Server failed health check. Should try to get healthy" | tee -a /home/user/recovery_backup/takeoverLog;
		getHealthy
	fi

	
elif $backup_currentlyServing; then
	echo "Backup Server is currently serving the website. Should prove I am healthy and ask for control back" | tee -a /home/user/recovery_backup/takeoverLog;
	# if server passes the health checks, ask for the control back

	if healthcheck; then
		echo "Server passed health checks. Requesting backup to unassign the IP address now" | tee -a /home/user/recovery_backup/takeoverLog;
		if ssh -i /home/user/.ssh/key_susie susie@192.168.1.4 'sudo /home/susie/recovery_backup/unassignIP'; then

			echo "Backup server successfully released the IP adress. Adding it now" | tee -a /home/user/recovery_backup/takeoverLog;
			
			if sudo ip addr add 192.168.1.5/24 dev wlan0; then
				echo "Successfully Added the address" | tee -a /home/user/recovery_backup/takeoverLog;
				letEverybodyKnow
			elif [ $? -eq 2 ]; then
				echo "Successfully Added the address" | tee -a /home/user/recovery_backup/takeoverLog;
				letEverybodyKnow
			else
				echo "Address couldn't be added successfully" | tee -a /home/user/recovery_backup/takeoverLog;
		
			fi
		else
			echo "Backup server couldn't unassign the IP address." | tee -a /home/user/recovery_backup/takeoverLog;
		fi
	else
		echo "Server failed health check. Should try to get healthy" | tee -a /home/user/recovery_backup/takeoverLog;
		getHealthy
	fi

else
	echo "Server is not healthy enough to operate" | tee -a /home/user/recovery_backup/takeoverLog;
	getHealthy
fi
